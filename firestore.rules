rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function countersNeverDecrease() {
      let incomingTrees  = request.resource.data.get('treesPlanted',   0);
      let existingTrees  = resource.data.get('treesPlanted',   0);
      let incomingCount  = request.resource.data.get('sessionsCount',  0);
      let existingCount  = resource.data.get('sessionsCount',  0);
      let incomingFocus  = request.resource.data.get('totalFocusTime', 0);
      let existingFocus  = resource.data.get('totalFocusTime', 0);
      return incomingTrees >= existingTrees
          && incomingCount >= existingCount
          && incomingFocus >= existingFocus;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && countersNeverDecrease();
    }

    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jawaan25fcrit@gmail.com';
    }

    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read, delete, update: if request.auth != null && request.auth.token.email == 'jawaan25fcrit@gmail.com';
    }

    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /friendships/{friendshipId} {
      allow read, write: if request.auth != null;
    }

    match /direct_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /rooms/{roomId} {
      allow read, write: if request.auth != null;
    }

    match /live_focusers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /chats/{msgId} {
      allow read, create, delete: if request.auth != null;
    }

    match /quest_signups/{docId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jawaan25fcrit@gmail.com';
    }

  }
}
